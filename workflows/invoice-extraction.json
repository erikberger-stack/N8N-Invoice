{
  "name": "Email Invoice to Google Sheets",
  "nodes": [
    {
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "simple": false,
        "filters": {
          "readStatus": "unread",
          "receivedAfter": "={{ $now.minus({ days: 1 }).toISO() }}"
        },
        "options": {
          "downloadAttachments": true,
          "attachmentPrefix": "attachment_"
        }
      },
      "id": "gmail-trigger",
      "name": "Gmail Trigger",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1.2,
      "position": [
        220,
        300
      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "",
          "name": "Gmail account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "has-attachment",
              "leftValue": "={{ $json.binaries }}",
              "rightValue": "",
              "operator": {
                "type": "object",
                "operation": "exists",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "filter-attachments",
      "name": "Has Attachments?",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "operation": "text",
        "options": {}
      },
      "id": "extract-binary",
      "name": "Extract from File",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "resource": "chat",
        "model": {
          "__rl": true,
          "value": "gpt-4o",
          "mode": "list",
          "cachedResultName": "gpt-4o"
        },
        "messages": {
          "values": [
            {
              "content": "=You are an expert at extracting data from German payment settlement invoices (Abrechnungen). Extract the following fields from this invoice text. Return ONLY valid JSON with these exact keys:\n\n- rechnungsnummer: The Rechnungsausgleich number (e.g. 333539812)\n- datum: The date from 'Ausstehende Onlinebezahlungen am ...' (format: YYYY-MM-DD)\n- ausstehende_onlinebezahlungen: The outstanding online payments amount (decimal number using dot as separator, e.g. 1209.75)\n- rechnungsausgleich: The invoice settlement amount (decimal number using dot, e.g. 112.31)\n- auszahlung: The payout amount (decimal number using dot, e.g. 1097.44)\n- iban: The IBAN bank account number (e.g. DE91100900002801119002)\n- empfaenger: The recipient company name (e.g. Yoko Sushi GmbH)\n- currency: The currency code (EUR, USD, etc.)\n\nIMPORTANT: German numbers use comma as decimal separator (1.209,75 means 1209.75). Convert ALL amounts to use dot as decimal separator in your output.\n\nInvoice text:\n{{ $json.data }}",
              "role": "user"
            }
          ]
        },
        "options": {
          "temperature": 0,
          "responseFormat": "json_object"
        }
      },
      "id": "openai-extract",
      "name": "OpenAI - Extract Invoice Data",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
      "position": [
        880,
        300
      ],
      "credentials": {
        "openAiApi": {
          "id": "",
          "name": "OpenAI account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json.message.content;\nconst data = JSON.parse(response);\n\nreturn [{\n  json: {\n    rechnungsnummer: data.rechnungsnummer || '',\n    datum: data.datum || '',\n    ausstehende_onlinebezahlungen: data.ausstehende_onlinebezahlungen || 0,\n    rechnungsausgleich: data.rechnungsausgleich || 0,\n    auszahlung: data.auszahlung || 0,\n    iban: data.iban || '',\n    empfaenger: data.empfaenger || '',\n    currency: data.currency || 'EUR',\n    email_subject: $('Gmail Trigger').first().json.subject || '',\n    email_from: $('Gmail Trigger').first().json.from?.value?.[0]?.address || '',\n    processed_at: new Date().toISOString()\n  }\n}];"
      },
      "id": "parse-response",
      "name": "Parse AI Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        300
      ]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "",
          "mode": "list"
        },
        "sheetName": {
          "__rl": true,
          "value": "",
          "mode": "list"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {}
        },
        "options": {}
      },
      "id": "google-sheets",
      "name": "Google Sheets - Append Row",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1320,
        300
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "",
          "name": "Google Sheets account"
        }
      }
    }
  ],
  "connections": {
    "Gmail Trigger": {
      "main": [
        [
          {
            "node": "Has Attachments?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has Attachments?": {
      "main": [
        [
          {
            "node": "Extract from File",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract from File": {
      "main": [
        [
          {
            "node": "OpenAI - Extract Invoice Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "OpenAI - Extract Invoice Data": {
      "main": [
        [
          {
            "node": "Parse AI Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse AI Response": {
      "main": [
        [
          {
            "node": "Google Sheets - Append Row",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": [],
  "triggerCount": 1
}
